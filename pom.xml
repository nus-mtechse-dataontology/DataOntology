<project>
  <groupId>nus-mtech-se</groupId>
  <artifactId>data-ontology</artifactId>
  <version>1.0.0-snapshot</version>
  <modelVersion>4.0.0</modelVersion>
  <packaging>pom</packaging>

  <properties>
    <antrun.plugin.version>3.2.0</antrun.plugin.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>${antrun.plugin.version}</version>
        <executions>
          <execution>
            <phase>generate-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <copy
                    file="${project.basedir}/templates/config.toml"
                    tofile="${project.basedir}/target/deployment/uat/config.toml">
                  <filterset>
                    <!-- Service related -->
                    <filter token="port" value="8000" />
                    <filter token="host" value="127.0.0.1" />

                    <!-- DB related -->
                    <filter token="db_host" value="127.0.0.1" />
                    <filter token="db_port" value="5432" />
                    <filter token="package" value="drivers.postgres_driver" />
                    <filter token="driver_class" value="PostgresDriver" />
                  </filterset>
                </copy>
                <copy
                    file="${project.basedir}/templates/config.toml"
                    tofile="${project.basedir}/target/deployment/prd/config.toml">
                  <filterset>
                    <!-- Service related -->
                    <filter token="port" value="8000" />
                    <filter token="host" value="127.0.0.1" />

                    <!-- DB related -->
                    <filter token="db_host" value="127.0.0.1" />
                    <filter token="db_port" value="5432" />
                    <filter token="package" value="drivers.postgres_driver" />
                    <filter token="driver_class" value="PostgresDriver" />
                  </filterset>
                </copy>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>